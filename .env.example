# ── Oracle chat ──────────────────────────────────────────────────────────────
# OpenAI API key for the Oracle endpoint (src/app/api/oracle/route.ts).
# Leave unset and set ORACLE_MOCK_MODE=true to run entirely without an API key.
OPENAI_API_KEY=

# Chat Completions model used by the Oracle. Optional; defaults to gpt-6-luna.
# Override here (or in Vercel env) to trial a new model on a preview deployment
# without a code change.
# ORACLE_MODEL=gpt-6-luna

# When "true", the Oracle returns canned demo replies and never calls OpenAI.
# Great for local development, demos, and CI.
ORACLE_MOCK_MODE=true

# ── Rate limiting (required in production) ───────────────────────────────────
# Upstash Redis REST credentials. In production the Oracle refuses to serve
# requests without them (fail-closed by design). In development an in-memory
# limiter is used instead, so these can stay empty locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Origin allow-list (optional) ─────────────────────────────────────────────
# Comma-separated list of origins allowed to call the Oracle API. If unset,
# the Vercel deployment URLs (and localhost in development) are derived
# automatically.
# ORACLE_ALLOWED_ORIGINS=https://example.com

# ── Site & analytics (optional) ──────────────────────────────────────────────
# Canonical site URL used in metadata/sitemap. Defaults to the project's
# Vercel URL if unset.
# NEXT_PUBLIC_SITE_URL=https://dragon-map.vercel.app

# Google Analytics 4 measurement ID. Analytics are disabled when unset.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
